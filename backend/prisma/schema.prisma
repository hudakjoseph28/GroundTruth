generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Internal row. Report responses are mapped in src/reports/mapReport.ts.
model ParcelRecord {
  key                 String        @id
  sourceParcelId      String
  county              String
  countyFips          String
  township            String?
  siteAddress         String?
  acreage             Decimal?      @db.Decimal(12, 4)
  latitude            Float
  longitude           Float
  geometryGeoJson     Json
  geometryAuthority   String
  geometrySourceUrl   String
  geometryRetrievedAt DateTime      @db.Timestamptz(3)
  report              ReportRecord?
}

model ReportRecord {
  parcelKey           String        @id
  parcel              ParcelRecord  @relation(fields: [parcelKey], references: [key], onDelete: Cascade)
  generatedAt         DateTime      @db.Timestamptz(3)
  coverage            String
  biggestOpenQuestion String
  checks              CheckRecord[]
}

model CheckRecord {
  id                      String         @id
  reportParcelKey         String
  report                  ReportRecord   @relation(fields: [reportParcelKey], references: [parcelKey], onDelete: Cascade)
  position                Int
  kind                    String
  status                  String
  finding                 String
  limitation              String
  nextAction              String
  responsibleRole         String
  responsibleOrganization String?
  publicContactUrl        String?
  reviewerWallet          String?
  transactionSignature    String?
  sources                 SourceRecord[]

  @@unique([reportParcelKey, kind])
}

/// Internal row. Deal responses are mapped in src/deals/mapDeal.ts.
/// `state`, reviewer approvals, `hold`, and confirmed timeline rows are
/// projections of confirmed chain events; the browser never writes them.
model DealRecord {
  id                 String                @id
  parcelKey          String
  buyerWallet        String
  sellerWallet       String
  sellerTokenAccount String
  amountBaseUnits    String
  mint               String
  cluster            String
  state              String
  /// Deal PDA. Confirmed program events are matched to a deal by this.
  escrowAddress      String?               @unique
  /// Only staged, non-sensitive demo deals are readable without auth.
  publicDemo         Boolean               @default(false)
  reviewers          ReviewerRecord[]
  hold               HoldRecord?
  timelineEvents     TimelineEventRecord[]
}

model ReviewerRecord {
  id                  String     @id
  dealId              String
  deal                DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position            Int
  wallet              String
  role                String
  required            Boolean
  approvedAt          DateTime?  @db.Timestamptz(3)
  approvalTransaction String?

  @@unique([dealId, wallet, role])
}

model HoldRecord {
  dealId               String     @id
  deal                 DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  placedByWallet       String
  role                 String
  reasonCode           String
  buyerMessage         String
  transactionSignature String
  placedAt             DateTime   @db.Timestamptz(3)
}

model TimelineEventRecord {
  id                   String     @id
  dealId               String
  deal                 DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  at                   DateTime   @db.Timestamptz(3)
  type                 String
  actorRole            String?
  buyerMessage         String
  transactionSignature String?
  /// Position of the program event inside its transaction.
  eventIndex           Int?
  slot                 BigInt?
  confirmationStatus   String

  /// QuickNode delivery dedupe: one row per program event.
  @@unique([transactionSignature, eventIndex])
  @@index([dealId, at])
}

model SourceRecord {
  id            String      @id
  checkId       String
  check         CheckRecord @relation(fields: [checkId], references: [id], onDelete: Cascade)
  position      Int
  authority     String
  title         String
  url           String
  retrievedAt   DateTime    @db.Timestamptz(3)
  effectiveDate DateTime?   @db.Timestamptz(3)
}
