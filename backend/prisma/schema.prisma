generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Internal row. Report responses are mapped in src/reports/mapReport.ts.
model ParcelRecord {
  key                 String        @id
  sourceParcelId      String
  county              String
  countyFips          String
  township            String?
  siteAddress         String?
  acreage             Decimal?      @db.Decimal(12, 4)
  latitude            Float
  longitude           Float
  geometryGeoJson     Json
  geometryAuthority   String
  geometrySourceUrl   String
  geometryRetrievedAt DateTime      @db.Timestamptz(3)
  report              ReportRecord?
}

model ReportRecord {
  parcelKey           String        @id
  parcel              ParcelRecord  @relation(fields: [parcelKey], references: [key], onDelete: Cascade)
  generatedAt         DateTime      @db.Timestamptz(3)
  coverage            String
  biggestOpenQuestion String
  /// Null for a seeded or manually verified report, which never expires.
  /// A live report (src/reports/store.ts) is served until this time.
  expiresAt           DateTime?     @db.Timestamptz(3)
  checks              CheckRecord[]
}

model CheckRecord {
  id                      String         @id
  reportParcelKey         String
  report                  ReportRecord   @relation(fields: [reportParcelKey], references: [parcelKey], onDelete: Cascade)
  position                Int
  kind                    String
  status                  String
  finding                 String
  limitation              String
  nextAction              String
  responsibleRole         String
  responsibleOrganization String?
  publicContactUrl        String?
  reviewerWallet          String?
  transactionSignature    String?
  sources                 SourceRecord[]

  @@unique([reportParcelKey, kind])
}

/// Internal row. Deal responses are mapped in src/deals/mapDeal.ts.
/// `state`, reviewer approvals, `hold`, and confirmed timeline rows are
/// projections of confirmed chain events; the browser never writes them.
model DealRecord {
  id                 String                  @id
  parcelKey          String
  buyerWallet        String
  sellerWallet       String
  sellerTokenAccount String
  amountBaseUnits    String
  mint               String
  cluster            String
  state              String
  /// Deal PDA. Confirmed program events are matched to a deal by this.
  escrowAddress      String?                 @unique
  /// Only staged, non-sensitive demo deals are readable without auth.
  publicDemo         Boolean                 @default(false)
  reviewers          ReviewerRecord[]
  hold               HoldRecord?
  timelineEvents     TimelineEventRecord[]
  ownerCalls         OwnerCallRecord[]
  smsSubscriptions   SmsSubscriptionRecord[]
  documents          DealDocumentRecord[]
}

/// A document a deal participant uploaded (src/documents). Public metadata
/// only; the bytes live in DealDocumentFileRecord and are read only after a
/// fresh wallet signature from a participant on the deal.
model DealDocumentRecord {
  id             String              @id
  dealId         String
  deal           DealRecord          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// titleCommitment | surveyPlat | septicSoilEvaluation | zoningLetter | other
  type           String
  filename       String
  /// Detected from the bytes: application/pdf | image/png | image/jpeg
  contentType    String
  sizeBytes      Int
  /// SHA-256 of the stored bytes, lowercase hex, computed by the API.
  sha256         String
  /// buyer | seller | title | survey | septic
  uploaderRole   String
  uploaderWallet String
  uploadedAt     DateTime            @db.Timestamptz(3)
  file           DealDocumentFileRecord?

  /// One copy of the same bytes per deal; an approval memo names the hash.
  @@unique([dealId, sha256])
  @@index([dealId, uploadedAt])
}

/// The private bytes of one deal document, kept apart so a metadata query
/// never loads them.
model DealDocumentFileRecord {
  documentId String             @id
  document   DealDocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    Bytes
}

/// A used document-request nonce. A signed request is accepted once.
model DocumentAuthNonceRecord {
  wallet String
  nonce  String
  usedAt DateTime @db.Timestamptz(3)

  @@id([wallet, nonce])
  @@index([usedAt])
}

/// A staged-demo opt-in to deal texts. Private: the number is never mapped
/// into a Deal response, logged, or returned except masked. Scoped to one
/// deal and deleted with it.
model SmsSubscriptionRecord {
  id          String           @id
  dealId      String
  deal        DealRecord       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// E.164, e.g. +16145550123.
  phoneNumber String
  consentedAt DateTime         @db.Timestamptz(3)
  alerts      SmsAlertRecord[]

  @@unique([dealId, phoneNumber])
}

/// One text per (confirmed timeline event, subscriber). Written in the same
/// transaction as the timeline row, so a replayed QuickNode delivery never
/// creates a second one; a claimed or sent row is never sent again.
model SmsAlertRecord {
  eventId           String
  event             TimelineEventRecord   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      SmsSubscriptionRecord @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// pending | sending | sent | failed
  status            String                @default("pending")
  attempts          Int                   @default(0)
  providerMessageId String?
  sentAt            DateTime?             @db.Timestamptz(3)

  @@id([eventId, subscriptionId])
}

/// One staged ElevenLabs owner callback, from a verified post-call webhook.
/// Holds only what the contract allows: no transcript, audio, or phone
/// number. Evidence for a reviewer; it never changes deal state.
model OwnerCallRecord {
  /// ElevenLabs conversation_id; the webhook dedupe key.
  conversationId   String     @id
  dealId           String
  deal             DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  completedAt      DateTime   @db.Timestamptz(3)
  /// Consenting demo participant, e.g. "Satya (teammate, consented)".
  participantLabel String
  /// ElevenLabs analysis.call_successful, or "notConnected".
  callSuccessful   String
  /// ownerDeniesSale | ownerConfirmsSale | unclear | noAnswer
  outcome          String
  receivedAt       DateTime   @default(now()) @db.Timestamptz(3)

  @@index([dealId])
}

model ReviewerRecord {
  id                  String     @id
  dealId              String
  deal                DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position            Int
  wallet              String
  role                String
  required            Boolean
  approvedAt          DateTime?  @db.Timestamptz(3)
  approvalTransaction String?

  @@unique([dealId, wallet, role])
}

model HoldRecord {
  dealId               String     @id
  deal                 DealRecord @relation(fields: [dealId], references: [id], onDelete: Cascade)
  placedByWallet       String
  role                 String
  reasonCode           String
  buyerMessage         String
  transactionSignature String
  placedAt             DateTime   @db.Timestamptz(3)
}

model TimelineEventRecord {
  id                   String           @id
  dealId               String
  deal                 DealRecord       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  at                   DateTime         @db.Timestamptz(3)
  type                 String
  actorRole            String?
  buyerMessage         String
  transactionSignature String?
  /// Position of the program event inside its transaction.
  eventIndex           Int?
  slot                 BigInt?
  confirmationStatus   String
  /// From a `groundtruth:doc:<sha256>` Memo in an approval's transaction.
  /// Matched to the deal's documents when the deal is read.
  citedDocumentSha256  String?
  smsAlerts            SmsAlertRecord[]

  /// QuickNode delivery dedupe: one row per program event.
  @@unique([transactionSignature, eventIndex])
  @@index([dealId, at])
}

model SourceRecord {
  id            String      @id
  checkId       String
  check         CheckRecord @relation(fields: [checkId], references: [id], onDelete: Cascade)
  position      Int
  authority     String
  title         String
  url           String
  retrievedAt   DateTime    @db.Timestamptz(3)
  effectiveDate DateTime?   @db.Timestamptz(3)
}

/// Land block assets built on demand by GET /api/parcels/:parcelKey/land
/// (src/land): NAIP imagery and Terrarium elevation for the parcel's padded
/// bounding box. A cache, rebuilt after expiresAt or a LandMeta version change.
model LandAssetRecord {
  parcelKey String   @id
  /// LAND_META_VERSION the assets were built with.
  version   Int
  meta      Json
  imagery   Bytes
  height    Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
}
