# Copy to backend/.env. Do not commit .env.
#
# Local disposable database (see README in this folder):
# DATABASE_URL=postgresql://groundtruth:groundtruth@localhost:5432/groundtruth
DATABASE_URL=postgresql://groundtruth:groundtruth@localhost:5432/groundtruth

# Optional. Defaults to 3001.
PORT=3001

# Optional. Returned by GET /api/health. Defaults to "unknown".
GIT_COMMIT=unknown

# QuickNode Stream security token (Stream settings > Security token).
# Unset: POST /api/webhooks/quicknode refuses every delivery with 503.
QUICKNODE_STREAM_TOKEN=

# Optional. Per-request limit for Ohio OGRIP parcel calls, in ms (500-60000).
# Defaults to 8000. A whole search may take up to twice this.
OGRIP_TIMEOUT_MS=

# Optional. Limit for a report's FEMA flood check (all NFHL queries), in ms
# (500-60000). Defaults to 6000. Past it the flood check is "unknown".
FEMA_TIMEOUT_MS=

# Optional. Limit for a Franklin report's county zoning check, in ms
# (500-60000). Defaults to 6000. Past it the zoning check is "unknown".
ZONING_TIMEOUT_MS=

# Optional. Limit for a Franklin report's road access check (county
# right-of-way and road layers together), in ms (500-60000). Defaults to 6000.
# Past it the access check is "unknown".
ACCESS_TIMEOUT_MS=

# --- ElevenLabs owner callback ---
# Server (Railway): post-call webhook signing secret. Unset:
# POST /api/webhooks/elevenlabs refuses every delivery with 503.
ELEVENLABS_WEBHOOK_SECRET=
# Server and local: the owner callback agent. On the server, calls from any
# other agent are acknowledged and ignored.
ELEVENLABS_AGENT_ID=

# Local only (call:owner script). Never set these on Railway or commit them.
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
# The consenting teammate's phone, in +E.164 form, e.g. +16145550123.
OWNER_CALLBACK_TO_NUMBER=
# Who agreed to take the call, e.g. "Satya (teammate, consented)".
OWNER_CALLBACK_PARTICIPANT_LABEL=
# Optional. Public demo deal the evidence attaches to. Defaults to staged-devnet-deal.
OWNER_CALLBACK_DEAL_ID=

# --- Deal text alerts (staged demo) ---
# Optional, all three or none. Unset: POST /api/deals/:id/sms-subscriptions
# answers 503 and nothing is texted. A partial set stops the API at startup.
# TWILIO_FROM_NUMBER is the team's existing Twilio number, in +E.164 form.
# Set these in Railway variables / backend/.env only. Never commit them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
