{
  "name": "@groundtruth/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:prod": "pnpm db:migrate && pnpm db:seed:dist && pnpm start",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "record:ogrip": "tsx scripts/record-ogrip-fixtures.ts",
    "time:search": "tsx scripts/time-address-search.ts",
    "record:report": "tsx scripts/record-report-fixtures.ts",
    "record:devnet": "tsx scripts/record-devnet-transactions.ts",
    "replay:devnet": "node --env-file-if-exists=.env --import tsx scripts/replay-devnet.ts",
    "call:owner": "node --env-file-if-exists=.env --import tsx scripts/call-owner.ts",
    "check:zoning": "tsx scripts/live-zoning-check.ts",
    "generate:id-formats": "tsx scripts/generate-parcel-id-formats.ts && prettier --write src/parcels/parcelIdFormats.ts",
    "generate:places": "tsx scripts/generate-ohio-places.ts && prettier --write src/parcels/ohioPlaces.ts",
    "lint": "pnpm -w exec eslint backend",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:dist": "node --env-file-if-exists=.env dist/seed.js"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@groundtruth/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "express": "5.3.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
