{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@12.18.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.18.0 --filter @groundtruth/web... build",
  "outputDirectory": "frontend/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-db8a8106.up.railway.app/api/:path*"
    },
    {
      "source": "/actions.json",
      "destination": "https://api-production-db8a8106.up.railway.app/actions.json"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
