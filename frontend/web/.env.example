# frontend/web environment. Copy to frontend/web/.env.local; never commit a real value.
# Vite exposes VITE_* variables to the browser, so only put browser-safe keys here.

# Optional. Turns on the in-app "3D area view" (Google Photorealistic 3D imagery)
# in the parcel page's "Explore the area" menu. Leave it empty and that option is
# not rendered and nothing from Google loads; the Google Maps and Google Earth
# links work either way.
# Needs a Google Cloud project with billing and the "Maps JavaScript API" and
# "Map Tiles API" enabled. Restrict the key to your site's HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=
