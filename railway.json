{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @groundtruth/backend... build"
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @groundtruth/backend db:migrate && pnpm --filter @groundtruth/backend db:seed:dist"
    ],
    "startCommand": "pnpm --filter @groundtruth/backend start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
